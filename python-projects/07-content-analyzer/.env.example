# Content Analyzer Configuration

# Ollama Configuration (Local - Phase 1)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava

# Anthropic Configuration (Cloud - Phase 2)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI Configuration (Cloud - Phase 2)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# Default Settings
DEFAULT_PROVIDER=ollama
DEFAULT_VISION_MODEL=llava

# Image Processing
MAX_IMAGE_SIZE_MB=3.75      # images are compressed to fit this before a model call
MAX_IMAGE_DIMENSION=2048    # ...and scaled down to this many pixels on the longer side
# MAX_UPLOAD_MB=25          # largest file accepted
# MAX_IMAGE_PIXELS=80000000 # most pixels accepted
# MAX_BATCH_FILES=50
# TESSERACT_TIMEOUT=90

# Web server (loopback by default; the API has no login)
# HOST=127.0.0.1
# PORT=8000
# CORS_ORIGINS=https://a.example,https://b.example
