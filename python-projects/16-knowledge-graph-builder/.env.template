# --- Server ---
API_HOST=127.0.0.1
API_PORT=8016
DEBUG=false

# --- Accounts ---
# False = single-user mode on your own machine: no sign-in, one shared graph belonging to "local"
REQUIRE_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_GUESTS=true
GUEST_TTL_HOURS=24
GUEST_MAX_DOCUMENTS=3
SESSION_DAYS=14
# Set true once the server is behind HTTPS
COOKIE_SECURE=false
ALLOWED_ORIGINS=

# --- Background jobs ---
JOB_WORKERS_ENABLED=true
MAX_CONCURRENT_DOCUMENTS=1
MAX_QUEUED_JOBS_PER_USER=10
JOB_MAX_ATTEMPTS=2
JOB_STALE_SECONDS=45

# --- Database (SQLite by default; any SQLAlchemy URL works, e.g. postgresql://...) ---
DATABASE_URL=sqlite:///./data/kg.db

# --- LLM used for extraction: ollama | anthropic | openai ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300
LLM_MAX_TOKENS=3072
# Cloud providers are optional and were NOT tested against the live APIs
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Questions (step 3) ---
EMBEDDING_MODEL=nomic-embed-text
INDEX_CHUNKS=true
ASK_MAX_FACTS=30
ASK_TOP_CHUNKS=4
ASK_MAX_HOPS=2
PREDICATE_THRESHOLD=0.62

# --- Extraction ---
CHUNK_CHARS=1500
CHUNK_OVERLAP_CHARS=200
# Ask the model to double-check each fact against its quote (catches reversed relations; costs one short call per fact)
VERIFY_FACTS=true
# Extra "what did you miss?" calls per chunk (0 = off). Small local models stop early, so 1 helps recall
GLEANING_PASSES=1
# Entity resolution: merge safe duplicates after each document ("Acme Corp" = "ACME"); the unsure ones become suggestions
AUTO_RESOLVE=true
# Ask the model for a second opinion on suggested merges when you run resolution
RESOLUTION_USE_LLM=false
MAX_UPLOAD_MB=20
MAX_DOCUMENT_CHARS=100000
