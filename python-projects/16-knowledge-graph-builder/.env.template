# --- Server ---
API_HOST=127.0.0.1
API_PORT=8016
DEBUG=false

# --- Database (SQLite by default; any SQLAlchemy URL works, e.g. postgresql://...) ---
DATABASE_URL=sqlite:///./data/kg.db

# --- LLM used for extraction: ollama | anthropic | openai ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300
# Cloud providers are optional and were NOT tested against the live APIs
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Extraction ---
CHUNK_CHARS=1500
CHUNK_OVERLAP_CHARS=200
# Ask the model to double-check each fact against its quote (catches reversed relations; costs one short call per fact)
VERIFY_FACTS=true
# Extra "what did you miss?" calls per chunk (0 = off). Small local models stop early, so 1 helps recall
GLEANING_PASSES=1
MAX_UPLOAD_MB=20
MAX_DOCUMENT_CHARS=100000
