# Server Configuration
PORT=8000
# Loopback by default. Use 0.0.0.0 only to serve other machines on your network
# (and then also set ALLOWED_ORIGINS to the address they will use)
HOST=127.0.0.1

# Database
DATABASE_URL=sqlite:///./data/database.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/chatdb

# Session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false  # Set to true in production with HTTPS

# CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Limits
MAX_MESSAGE_CHARS=20000
MAX_SYSTEM_PROMPT_CHARS=8000
# Failed logins per username and client before a 5-minute lockout
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=300

# LLM Providers

# Ollama (default, local)
OLLAMA_API_URL=http://localhost:11434
# Context window requested from Ollama (its own default is 4096 tokens and it silently
# drops the oldest text of a longer chat). Larger values use more memory.
OLLAMA_NUM_CTX=8192

# OpenAI (optional)
OPENAI_API_KEY=your_openai_key_here

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Image Generation

# Stable Diffusion (local, optional) - runs in-process via the diffusers
# library (src/local_sd_service.py), not the WebUI/ComfyUI HTTP API - no
# separate server to start. Downloads the model (~4GB) to the
# HuggingFace cache on first use.
#
# HF_TOKEN is only needed if you set a *gated* model id in
# local_sd_service.py's LocalSDService(model_id=...) (e.g. a
# stabilityai/* model, which requires a HuggingFace account that has
# accepted that model's license). The default model doesn't need one.
# HF_TOKEN=your_huggingface_token_here

# DALL-E uses the same OPENAI_API_KEY above
