# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./data/database.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/chatdb

# Session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false  # Set to true in production with HTTPS

# CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# LLM Providers

# Ollama (default, local)
OLLAMA_API_URL=http://localhost:11434

# OpenAI (optional)
OPENAI_API_KEY=your_openai_key_here

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Image Generation

# Stable Diffusion (local, optional) - runs in-process via the diffusers
# library (src/local_sd_service.py), not the WebUI/ComfyUI HTTP API - no
# separate server to start. Downloads the model (~4GB) to the
# HuggingFace cache on first use.
#
# HF_TOKEN is only needed if you set a *gated* model id in
# local_sd_service.py's LocalSDService(model_id=...) (e.g. a
# stabilityai/* model, which requires a HuggingFace account that has
# accepted that model's license). The default model doesn't need one.
# HF_TOKEN=your_huggingface_token_here

# DALL-E uses the same OPENAI_API_KEY above
