# Server Configuration
PORT=3000
# Listen on loopback only (default). 0.0.0.0 exposes the assistant to your whole network, with no login.
HOST=127.0.0.1
NODE_ENV=development

# Phase 5: Service Mode
# Options: cloud, local, hybrid
# cloud = OpenAI only (requires OPENAI_API_KEY)
# local = Local models only (requires whisper.cpp and local TTS)
# hybrid = Prefer local with cloud fallback (best of both worlds)
SERVICE_MODE=local
FALLBACK_TO_CLOUD=true

# OpenAI API Configuration (for cloud/hybrid mode) - optional, leave blank
# to run fully local/offline (AI fallback questions just won't have live
# tool access - weather/F1 commands and local conversation still work)
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Phase 5: Local Whisper Configuration (for local/hybrid mode)
# Download models from: https://huggingface.co/ggerganov/whisper.cpp
WHISPER_CPP_PATH=./whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=./whisper.cpp/models/ggml-base.en.bin
WHISPER_THREADS=4

# Phase 5: Local TTS Configuration (for local/hybrid mode)
# Supported engines: espeak, piper, festival
# espeak: apt-get install espeak (Linux) or brew install espeak (Mac)
# piper: Download from https://github.com/rhasspy/piper
# festival: apt-get install festival
TTS_ENGINE=espeak
TTS_SPEED=175

# Phase 5.5: Local LLM Configuration (for local/hybrid mode)
# Ollama server URL (install: brew install ollama)
LLM_BASE_URL=http://localhost:11434
# Available models: llama3.2:3b, phi3:mini, qwen2.5:3b, gemma2:2b
# Pull model: ollama pull llama3.2:3b
LLM_MODEL=llama3.2:3b
# Response timeout (ms)
LLM_TIMEOUT=30000

# Web Search + Weather (optional real API integrations - each degrades
# gracefully on its own if left blank, no crash either way)
# Tavily: sign up free at https://tavily.com for real web search results.
# Optional - leave blank and web_search automatically falls back to
# DuckDuckGo's free Instant Answer API (no signup needed), which covers
# direct factual questions but not general/current-events search
TAVILY_API_KEY=
# OpenWeatherMap: sign up free at https://openweathermap.org/api; leave
# blank and the weather command/tool will say so instead of answering
OPENWEATHER_API_KEY=
# Used when a weather request doesn't name a city, e.g. "what's the weather"
DEFAULT_WEATHER_LOCATION=Houston,TX,US

# Audio Settings
MAX_AUDIO_SIZE_MB=25
AUDIO_TEMP_DIR=./data/audio-cache
CLEANUP_INTERVAL_MS=3600000

# Conversation Settings
CONVERSATIONS_DIR=./data/conversations
MAX_CONVERSATION_LENGTH=50
CONTEXT_WINDOW=10

# Rate Limiting (per client, on /api/command, /api/transcribe and /api/synthesize)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Local tools
# ffmpeg converts the browser's recording for Whisper (found on PATH by default)
FFMPEG_PATH=ffmpeg
# How many transcriptions run at once; the rest wait their turn
WHISPER_CONCURRENCY=2

# CORS - leave blank: the page and the API share an origin, so no other site needs access.
# Comma-separated origins to allow; "*" lets any website call your assistant (only on purpose).
ALLOWED_ORIGINS=

# Logging
LOG_LEVEL=info
