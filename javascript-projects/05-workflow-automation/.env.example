# Node.js Server
PORT=3000
HOST=127.0.0.1
# CORS_ORIGIN=
PYTHON_PATH=python3
PYTHON_TIMEOUT=300000

# Python/LLM Configuration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_MAX_TOKENS=4096
OLLAMA_TIMEOUT=240
OLLAMA_MAX_CTX=32768
OLLAMA_THINK=false
MARKET_DATA_TIMEOUT=10
SCHEDULES_FILE=data/schedules.json
SCHEDULER_TICK_MS=10000
MAX_SCHEDULES=50
SCHEDULER_PAUSE_AFTER_FAILURES=10
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage Paths
WORKFLOWS_DIR=./workflows
EXECUTIONS_DIR=./data/executions

# Execution Settings
MAX_CONCURRENT_EXECUTIONS=5
